# Copy to /mnt/POOL/apps/observability/grafana.env on the NAS and fill in.
# Keep the file private: chmod 600 grafana.env

GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Links in alert e-mails point here
GF_SERVER_ROOT_URL=http://NAS-IP:3000

# Who gets alert e-mails (several: separated by ;)
ALERT_EMAIL=du@example.de

# Same SMTP access as the app (app.env); host WITH port
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.de:587
GF_SMTP_USER=du@example.de
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=du@example.de
GF_SMTP_FROM_NAME=Plattensammlung Monitoring
# 587 = STARTTLS (MandatoryStartTLS), 465 = TLS (NoStartTLS)
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
