# Copy to /mnt/POOL/apps/plattensammlung/app.env on the NAS and fill in.
# Keep the file private: chmod 600 app.env

# Public address (without https://), as configured in nginx-proxy-manager
PHX_HOST=platten.example.de

# Optional: path prefix when the app shares a domain with others, e.g.
# https://cloud.example.com/plattensammlung -> PHX_HOST=cloud.example.com,
# PHX_PATH=/plattensammlung (see deploy/README.md, "Unter einem Pfad")
# PHX_PATH=/plattensammlung

# Generate each with `mix phx.gen.secret` (on the Mac, in the project folder)
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=

# Same password as POSTGRES_PASSWORD in db.env; "db" is the database container
DATABASE_URL=ecto://postgres:CHANGE_ME@db/plattensammlung

# Who may sign in, comma separated
ALLOWED_EMAILS=du@example.de

# Magic link e-mails via your mail provider (port 587 = STARTTLS, 465 = TLS)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USERNAME=du@example.de
SMTP_PASSWORD=
# Sender address; most providers require your own address here
MAIL_FROM=du@example.de

# Optional
DISCOGS_TOKEN=
MUSICBRAINZ_CONTACT=

# Optional: traces to Tempo (see deploy/observability, ADR 0019). Without it no
# traces leave the app.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://NAS-IP:4318
